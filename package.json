{
  "name": "@poke-me/sdk",
  "version": "0.1.0",
  "description": "Browser client SDK for poke-me — web push addressed to your own app's users.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slugkit/poke-me-sdk-ts.git"
  },
  "homepage": "https://github.com/slugkit/poke-me-sdk-ts",
  "bugs": {
    "url": "https://github.com/slugkit/poke-me-sdk-ts/issues"
  },
  "keywords": [
    "push",
    "web-push",
    "vapid",
    "notifications",
    "service-worker"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "default": "./dist/sw.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
